# Copie este arquivo para .env.local e preencha com os dados do SEU projeto Supabase.
# O app funciona 100% offline se estas variáveis ficarem vazias (só localStorage).
#
# Atenção: tudo que começa com VITE_ é embutido no JavaScript publicado e fica
# visível para quem abrir o site. Isso é esperado para as duas primeiras (a
# chave anon é pública por design, quem protege a tabela é o RLS do Supabase),
# mas significa que o FAMILY_ID abaixo é o que realmente separa os seus dados
# dos de outra pessoa. Trate-o como senha.

# URL do seu projeto (Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=

# Chave pública (publishable/anon) do seu projeto — segura para uso no browser
VITE_SUPABASE_ANON_KEY=

# Identificador único da sua família/grupo. Use um UUID — algo longo e aleatório.
# Gere um com:  node -e "console.log(crypto.randomUUID())"
# NÃO use algo adivinhável como "familia-silva" ou "meus-dados-123".
VITE_SUPABASE_FAMILY_ID=
